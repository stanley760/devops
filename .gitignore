deploy/.dev-logs/
deploy/*/*-*.md
# Runtime state (snowflake worker slots / ID watermark cache)
data/

# Editors / IDEs
.idea/
.vscode/

# Operating systems
.DS_Store
Thumbs.db


# Local dev tools (Redis, etc.)
.tools/

# Local environment variables (incl. APP_ENV / NACOS_REGISTER_IP, etc.; not committed)
**/config/.env
