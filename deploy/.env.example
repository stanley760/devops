# Local observability-stack environment variables.
# Copy this file to deploy/.env and adjust as needed; deploy/.env is not committed.
#
# Host LAN IPv4. Used by:
#   - Prometheus: scraping host-run business services via the devops-host alias
#   - The Higress gateway in dev compose: extra_hosts maps the K8s-style service
#     FQDNs of the host-run business services to this address
# Update it when the machine changes networks.
HOST_IP=192.168.1.1
