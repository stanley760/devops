    {
      "id": 6,
      "type": "timeseries",
      "title": "SQL pool saturation (%)",
      "description": "In-use connections as a share of MaxOpenConns per database.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 70
                  },
                  {
                    "color": "red",
                    "value": 90
                  }
                ]
              }
            }
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * go_sql_in_use_connections{job=\"devops-services\",service_name=~\"$service\",deployment_environment=~\"$env\"} / go_sql_max_open_connections{job=\"devops-services\",service_name=~\"$service\",deployment_environment=~\"$env\"}",
          "legendFormat": "{{service_name}} {{db_name}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
