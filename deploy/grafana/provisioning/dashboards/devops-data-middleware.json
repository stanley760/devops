    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit rate (%)",
      "description": "Application-level cache hit rate from devops_cache_operations_total. The cache label is a logical name, never a raw key.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 30
                  },
                  {
                    "color": "red",
                    "value": 50
                  }
                ]
              }
            }
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (cache) (rate(devops_cache_operations_total{job=\"devops-services\",service_name=~\"$service\",deployment_environment=~\"$env\",result=\"hit\"}[5m])) / (sum by (cache) (rate(devops_cache_operations_total{job=\"devops-services\",service_name=~\"$service\",deployment_environment=~\"$env\",result=\"hit\"}[5m])) + sum by (cache) (rate(devops_cache_operations_total{job=\"devops-services\",service_name=~\"$service\",deployment_environment=~\"$env\",result=\"miss\"}[5m])))",
          "legendFormat": "{{cache}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cache operations (hit / miss)",
      "description": "Application cache lookup rate split by result.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
