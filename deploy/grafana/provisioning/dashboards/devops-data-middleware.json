          },
          "unit": "reqps"
        },
        "overrides": null
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache, result) (rate(devops_cache_operations_total{job=\"devops-services\",service_name=~\"$service\",deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "{{cache}} {{result}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
