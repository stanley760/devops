      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": null
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (client_ip) (count_over_time({service_name=~\"$service\",deployment_environment=~\"$env\"} | client_ip!=\"\" [1m])))",
          "legendFormat": "{{client_ip}}"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Error log stream",
      "description": "Live stream of error-level log lines; empty while the system is healthy.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": null
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\",deployment_environment=~\"$env\"} | detected_level=\"error\""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Authentication failure stream",
      "description": "Live stream of log lines carrying a 401 or 403 status.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": null
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\",deployment_environment=~\"$env\"} | status=~\"401|403\""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Login failures",
      "description": "Failed login attempts per second, per service. The counter is lazy, so an empty series means no login has been attempted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": null
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(auth_login_total{service_name=~\"$service\",deployment_environment=~\"$env\",result=\"failure\"}[5m])) or vector(0)",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Login failure rate (%)",
      "description": "Share of login attempts that failed; the business code distinguishes credential failures from server errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": {
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 30
                  },
                  {
                    "color": "red",
                    "value": 50
                  }
                ]
              }
            }
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (service_name) (rate(auth_login_total{service_name=~\"$service\",deployment_environment=~\"$env\",result=\"failure\"}[5m])) / sum by (service_name) (rate(auth_login_total{service_name=~\"$service\",deployment_environment=~\"$env\"}[5m])) or vector(0)",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
