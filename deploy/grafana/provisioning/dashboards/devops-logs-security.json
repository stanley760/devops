    {
      "id": 5,
      "type": "table",
      "title": "Top request paths",
      "description": "The ten most frequently logged request paths.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": null
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (path) (count_over_time({service_name=~\"$service\",deployment_environment=~\"$env\"} | path!=\"\" [1m])))",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Slowest requests (by path)",
      "description": "The ten paths with the highest observed request latency. Latency is aggregated, never used as a grouping label.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": null
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, max by (path) (max_over_time({service_name=~\"$service\",deployment_environment=~\"$env\"} | unwrap duration(latency) | __error__=\"\" [1m])))",
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top client IPs",
      "description": "The ten client addresses producing the most log lines.",
      "datasource": {
        "type": "loki",
