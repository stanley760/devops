    {
      "id": 20,
      "type": "timeseries",
      "title": "Uptime (restart detection)",
      "description": "time() - process_start_time_seconds: the curve dropping back to zero means the process just restarted; use together with the goroutines panel to spot unplanned restarts",
      "datasource": {
