{
  "__inputs": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "devops microservices observability dashboard: service RED (HTTP/gRPC server + client) + edge gateway + dependency USE (MySQL/Redis connection pools) + Go runtime + auth business (login/register). Filter with the $service/$env variables; adding a service requires no panel duplication. Metrics come from the OTel Prometheus exporter; the service_name label comes from the OTel Resource. HTTP latency quantiles are shown in dedicated panels; other comparison metrics use fixed colors keyed by legend name.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Jaeger UI",
      "type": "link",
      "url": "http://localhost:16686"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP QPS (by route)",
      "description": "sum(rate(http_server_requests_total[1m])) by (route), filtered by $service/$env",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate: application 5xx vs gateway edge",
      "description": "Two error-rate curves side by side on one chart: application 5xx (red, http_server_requests_total, business/service failures) and gateway 4xx+5xx (orange, envoy_http_downstream_rq, includes gateway-generated errors such as no route and upstream down — invisible to the backend). Edge elevated while application flat = gateway/routing issue; both elevated = the service itself. or vector(0) pads to a displayed 0 when there are no errors; no data at all = no traffic. >1% yellow, >5% red",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "App 5xx"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gateway 4xx+5xx"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\", status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "App 5xx"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(envoy_http_downstream_rq{job=\"higress-gateway\", http_conn_manager_prefix=~\"outbound.*\", response_code_class=~\"4xx|5xx\"}[5m])) or vector(0)) / (sum(rate(envoy_http_downstream_rq{job=\"higress-gateway\", http_conn_manager_prefix=~\"outbound.*\"}[5m])) or vector(0))",
          "legendFormat": "Gateway 4xx+5xx"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP status code distribution",
      "description": "Request rate by exact status code: 200/401/403/404/500 etc. A 4xx spike (e.g. a flood of 401s) never shows up in the 5xx panel",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP latency P95 (by route)",
      "description": "HTTP request latency P95 by route, to locate which routes are slow overall; compare with the P99 panel to tell whether latency is driven mainly by tail requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, route))",
          "legendFormat": "P95 {{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP latency P99 (by route)",
      "description": "HTTP request latency P99 by route, reflecting slow tail requests; a sustained approach to the 1s SLO (DevOpsHTTPP99High) means load tests are falling short.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, route))",
          "legendFormat": "P99 {{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "http_server_in_flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "http_server_in_flight{service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "gRPC call rate (server, method × status)",
      "description": "Produced automatically by the otelgrpc stats handler; rpc_response_status_code != OK counts as an error",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rpc_server_call_duration_seconds_count{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (rpc_method, rpc_response_status_code)",
          "legendFormat": "{{rpc_method}} [{{rpc_response_status_code}}]"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "gRPC P99 latency: server vs client",
      "description": "gRPC P99 from both sides on one chart: server (blue, rpc_server_*, callee view) and client (purple, rpc_client_*, caller view — end-to-end time for the ID-generation calls devops-system → devops-id BatchNext/prefetch refill). Server flat while client high = network/timeout retries/client-side queue; both high = the service itself is slow (compare against the domain-layer baseline ceiling of ~427ns per ID). Colors are overridden by legend-name regex; the legend name distinguishes methods",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Server.*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Client.*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(rpc_server_call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, rpc_method))",
          "legendFormat": "Server {{rpc_method}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(rpc_client_call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, rpc_method))",
          "legendFormat": "Client {{rpc_method}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "gRPC client call rate (method × status)",
      "description": "Caller view (devops-system → devops-id): the client stats handler exports rpc_client_* from the caller process, so cases where the server looks “normal” but the caller is timing out and retrying are only visible here",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rpc_client_call_duration_seconds_count{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (rpc_method, rpc_response_status_code)",
          "legendFormat": "{{rpc_method}} [{{rpc_response_status_code}}]"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Gateway edge: QPS × status class",
      "description": "Envoy HTTP connection manager counter envoy_http_downstream_rq aggregated by response_code_class (1xx–5xx); http_conn_manager_prefix=~outbound.* takes only the external 8080/8443 listeners (excluding admin/agent/stats internal endpoints). Gateway-generated 4xx/5xx (no route, upstream down) are never seen by the backend — only visible at this layer",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (response_code_class) (rate(envoy_http_downstream_rq{job=\"higress-gateway\", http_conn_manager_prefix=~\"outbound.*\"}[5m]))",
          "legendFormat": "{{response_code_class}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Gateway edge: P99 latency (by target)",
      "description": "P99 of envoy_cluster_upstream_rq_time_bucket (millisecond histogram, /1000 to seconds); cluster_name is the full Envoy upstream name (outbound|port||service.group.namespace.nacos), which distinguishes gray instances. A cluster series only appears once business traffic flows through the gateway",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, cluster_name) (rate(envoy_cluster_upstream_rq_time_bucket{job=\"higress-gateway\", cluster_name=~\"outbound.*\"}[5m]))) / 1000",
          "legendFormat": "{{cluster_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "MySQL connection pool: in-use/idle/max",
      "description": "go_sql_* registered by devops-infra InstrumentGORM (client_golang DBStatsCollector), with db_name as the label; pool saturation (in-use approaching max) is the precursor of queueing and timeout errors. Directly scraped metrics carry no service_name label; they land on devops-system by scrape target (instance)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_sql_max_open_connections{job=\"devops-services\"}",
          "legendFormat": "Max {{db_name}}"
        },
        {
          "refId": "B",
          "expr": "go_sql_in_use_connections{job=\"devops-services\"}",
          "legendFormat": "In use {{db_name}}"
        },
        {
          "refId": "C",
          "expr": "go_sql_idle_connections{job=\"devops-services\"}",
          "legendFormat": "Idle {{db_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "MySQL connection pool: waiting",
      "description": "go_sql_wait_count_total (waits/second) and go_sql_wait_duration_seconds_total (wait-seconds/second). Sustained > 0 means MaxOpenConns is too small or slow queries are holding connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_name) (rate(go_sql_wait_count_total{job=\"devops-services\"}[5m]))",
          "legendFormat": "Waits/s {{db_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (db_name) (rate(go_sql_wait_duration_seconds_total{job=\"devops-services\"}[5m]))",
          "legendFormat": "Wait time/s {{db_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Redis connection pool: used/idle/max",
      "description": "OTel db.client.connections.* series produced by redisotel InstrumentMetrics (Prometheus names db_client_connections_*); pool_name is the Redis address",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_client_connections_max{service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "Max"
        },
        {
          "refId": "B",
          "expr": "db_client_connections_usage{state=\"used\", service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "In use {{pool_name}}"
        },
        {
          "refId": "C",
          "expr": "db_client_connections_usage{state=\"idle\", service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "Idle {{pool_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Redis pool: waits/timeouts",
      "description": "db_client_connections_waits / timeouts. Waits > 0 are an early signal of an undersized pool; timeouts > 0 mean requests are already being rejected (Redis unavailable or pool exhausted)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool_name) (rate(db_client_connections_waits{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "Wait/s {{pool_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pool_name) (rate(db_client_connections_timeouts{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "Timeout/s {{pool_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Go runtime: goroutines",
