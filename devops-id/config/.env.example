# devops-id local development environment variables
# Copy to .env and adjust as needed (.env is not committed).
# OS environment variables already set take precedence; .env never overrides them -- safe for CI/container injection.

# Environment name: decides which devops-id-<env>.yaml to merge (dev / test / prod)
APP_ENV=dev

# Service version: shown in the banner on local go run; CI/CD injection via -ldflags takes precedence
APP_VERSION=0.1.0-dev

# Nacos registration IP: the address the local process registers with Nacos; must be a host LAN IPv4 that Higress/clients can connect back to
# When unset, the code automatically picks the first non-loopback IPv4
NACOS_REGISTER_IP=192.168.1.20
